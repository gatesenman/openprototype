# Copy to .env and adjust for your environment.
# Postgres DSN (SQLAlchemy URL). The docker-compose dev DB maps to port 5433.
DATABASE_URL=postgresql+psycopg2://openprototype:openprototype@localhost:5433/openprototype

# Use a long random string in production (>= 32 bytes).
JWT_SECRET=change-me-to-a-long-random-secret-string-please-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
