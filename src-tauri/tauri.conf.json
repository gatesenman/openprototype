{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPrototype",
  "version": "0.1.0",
  "identifier": "app.openprototype",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenPrototype",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-driven product prototyping studio",
    "longDescription": "OpenPrototype is an AI-driven product prototyping studio: write requirements, generate editable pages, fine-tune on a free canvas, wire up flows, and export demo-ready prototypes."
  },
  "plugins": {}
}
